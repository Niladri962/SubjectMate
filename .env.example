# Copy to .env for local development. On Vercel, set these under Project > Settings > Environment Variables.

# Needed on Vercel to embed questions with the same sentence-transformers model used for the index.
# Free read token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Server-side LLM keys. Set at least one; users can also paste their own key in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional
# OLLAMA_MODEL=llama3.2:3b         # local, free LLM via Ollama (local runs only, not on Vercel)
# LLM_PROVIDER=anthropic          # provider selected by default
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# TOP_K=5
# MIN_SCORE=0.15                  # below this similarity the app abstains without calling the LLM
